@article{https://doi.org/10.1111/poms.13239,
author = {Lu, Mengshi and Shen, Zuo-Jun Max},
title = {A Review of Robust Operations Management under Model Uncertainty},
journal = {Production and Operations Management},
volume = {30},
number = {6},
pages = {1927-1943},
keywords = {operations management, robust optimization, model uncertainty},
doi = {https://doi.org/10.1111/poms.13239},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/poms.13239},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/poms.13239},
abstract = {Over the past two decades, there has been explosive growth in the application of robust optimization in operations management (robust OM), fueled by both significant advances in optimization theory and a volatile business environment that has led to rising concerns about model uncertainty. We review some common modeling frameworks in robust OM, including the representation of uncertainty and the decision-making criteria, and sources of model uncertainty that have arisen in the literature, such as demand, supply, and preference. We discuss the successes of robust OM in addressing model uncertainty, enriching decision criteria, generating structural results, and facilitating computation. We also discuss several future research opportunities and challenges.},
year = {2021}
}

