





@article{doi:10.1137/140967337,
author = {Song, Yongjia and Luedtke, James},
title = {An Adaptive Partition-Based Approach for Solving Two-Stage Stochastic Programs with Fixed Recourse},
journal = {SIAM Journal on Optimization},
volume = {25},
number = {3},
pages = {1344-1367},
year = {2015},
